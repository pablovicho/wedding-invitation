# Opcional — para la función "Palabras" (libro de visitas). Dejar vacío si no se usa.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional — protección anti-spam (Cloudflare Turnstile) para wish/rsvp.
# La Site Key es pública; el Secret se configura en Apps Script o en Cloudflare Pages (TURNSTILE_SECRET).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Opcional — login de Google para /checkin/ y /generator/ (OAuth Web Client ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Opcional — servir /private/ desde Cloudflare R2 u otro CDN.
# Ejemplo: https://media.tudominio.com (sin barra final). Si está vacío, se usa public/private local.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Solo para `npm run media:upload` (no se expone al navegador).
R2_BUCKET=

# Opcional — rellenar si se aloja en un subdirectorio (p. ej. sitio de proyecto de GitHub Pages)
# BASE_PATH=/wedding-invitation
