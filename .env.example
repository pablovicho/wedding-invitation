# Opcional — para la función "Ucapan & Doa" (libro de visitas). Dejar vacío si no se usa.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional — protección anti-spam (Cloudflare Turnstile) para wish/rsvp.
# La Site Key es pública; el Secret se configura en Apps Script o en Cloudflare Pages (TURNSTILE_SECRET).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Opcional — login de Google para /checkin/ y /generator/ (OAuth Web Client ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Opcional — rellenar si se aloja en un subdirectorio (p. ej. sitio de proyecto de GitHub Pages)
# BASE_PATH=/wedding-invitation
